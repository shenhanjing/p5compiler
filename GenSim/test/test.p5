#define PG_OUTER_L2  0
#define PG_OUTER_L3  1
#define PG_OUTER_L4  2

#define IP_PROTOCOL_TCP      0x06
#define IP_PROTOCOL_UDP      0x11

enum RSP_STATUS_E
{
  RSP_STATUS_MATCH          = 0,
  RSP_STATUS_NO_MATCH       = 1,
  RSP_STATUS_LOOKUP_SKIPPED = 2,
  RSP_STATUS_ERROR          = 3
};

enum TLB_LKUP_TYPE_E
{
  TBL_LKUP_TYPE_INDEX                    = 0,
  TBL_LKUP_TYPE_EM                       = 1,
  TBL_LKUP_TYPE_LPM                      = 3,
  TBL_LKUP_TYPE_TCAM                     = 4
};

enum SE_TID_E
{
    SE_TID_IPAT                    =    0,
    SE_TID_FIB                     =    1,
    SE_TID_EPAT                    =    2,
    SE_TID_ENCAP                   =    3
};

enum PORT_TYPE_E
{
    PORT_TYPE_ETH          = 0,
    PORT_TYPE_CPU          = 1,
    PORT_TYPE_STACK        = 2
};

enum PHO_OFFSETS_E 
{
  PHO_OUTER_L2_START                    = 0,
  PHO_OUTER_VLANS_START                 = 1,
  PHO_OUTER_L3_START                    = 2,
  PHO_OUTER_L4_START                    = 3

};

enum L4_PROTOCOL_E
{
  L4_PROTOCOL_NONE             = 0,

  L4_PROTOCOL_TCP              = 10,
  
  L4_PROTOCOL_UDP	             = 32
};

enum L2_TYPE_E
{
  L2_TYPE_INVALID  = 0,
  L2_TYPE_ETHERNET = 1,
  L2_TYPE_OTHER    = 2,
  L2_TYPE_RES      = 3
};

enum VLAN_TYPE_E
{
  VLAN_UNTAGGED = 0,
  VLAN_SINGLE_TAGGED = 1,
  VLAN_DOUBLE_TAGGED = 2,
  VLAN_TRIPLE_TAGGED = 3
};
enum L3_TYPE_E
{
  L3_TYPE_INVALID = 0,
  L3_TYPE_NON_IP = 1,
  L3_TYPE_IPv4 = 2,
  L3_TYPE_IPv6 = 3
};

struct PHI_S //18 | 3 | 5
{
  uint<4> PortType;
  uint<2> L2Type;
  uint<2> TagType;
  uint<2> L3Type;
  uint<8> L4Type;
};

struct ETHER_TYPE_S //16 | 2 | 2
{
  uint<16>    Type;
};

struct ETHER_S //96 | 12 | 12
{
  uint<48> Dmac;
  uint<48> Smac;
  ETHER_TYPE_S ETHER_TYPE;
};

struct VlanInfo_S { //16 | 2 | 3
    union {
        uint<4> PriCfi;
        struct {
            uint<3> Pri;
            uint<1> Dei;
        };
    };
    uint<12> VlanID;
};

struct VLAN_TAG_S //32 | 4 | 5
{
  uint<16>     Tpid;
  VlanInfo_S   VlanInfo;
  ETHER_TYPE_S ETHER_TYPE;
};

struct IPv4_S //160 | 20 | 24
{
  uint<4>    Version;
  uint<4>    Ihl;
  union
  {
    uint<8>    TOS;
    uint<6>    DSCP;
    uint<3>    Precedence;
  } u_0;
  uint<16>    TotalLen;
  uint<16>    Iden;
  uint<1>     R;
  uint<1>     DF;
  uint<1>     MF;
  uint<13>    FragOffset;
  uint<8>       TTL;
  uint<8>       Protocol;
  uint<16>      Checksum;
  uint<32>      SIP;
  uint<32>      DIP;
};
struct IPv6_S //320 | 40 | 41
{
  uint<4>   Version;
  union
  {
    uint<8>   TC;              /*Traffic Class*/
    uint<6>   DSCP;            /*Differentiated services code point*/
    uint<3>   Precedence;      /*IP Precedence*/
  };
  uint<20>  FlowLabel;            /*Flow Label*/
  uint<16>  PayloadLen;           /*Length of packet after IPv6 header*/
  uint<8>   NextProtocol;         /*Type of next header after this one*/
  uint<8>   HopLmt;               /*Hop limit*/
  uint<128>  SIP;                 /*Source address */
  uint<128>  DIP;                 /*Destination address  */
};

struct UDP_S //64 | 8 | 8
{
  uint<16>    SrcPort;
  uint<16>    DstPort;
  uint<16>    Length;
  uint<16>    Checksum;
};

struct FlagCtrl_S //6 | 1 | 6
{
  uint<1>    Urg;
  uint<1>    Ack;
  uint<1>    Psh;
  uint<1>    Rst;
  uint<1>    Syn;
  uint<1>    Fin;
};

struct DataCtrl_S //16 | 2 | 8
{
  uint<4>    DataOffset;
  union {
    struct {
      uint<3>    Res;
      uint<3>    Ecn;
    };
    struct {
      uint<4>    Hr2n;  // Private usage
      uint<2>    Ecn1;
    };
  };
  FlagCtrl_S Ctrl;
};

struct TCP_S //160 | 20 | 26
{
  uint<16>    SrcPort;
  uint<16>    DstPort;
  uint<32>    SeqNo;
  uint<32>    AckNo;
  DataCtrl_S  DataCtrl;
  uint<16>    Window;
  uint<16>    Checksum;
  uint<16>    UrgentPtr;
};

/****************************        Outer Headers           *********************************/
header ETHER_S ETHER;
header VLAN_TAG_S VLAN_TAG0;
header ETHER_TYPE_S ETHER_TYPE;

header IPv4_S IPv4;
header IPv6_S IPv6;

header UDP_S UDP;
header TCP_S TCP;

/****************************        FV           *********************************/
@segment("PHI") @volatile("PHI", "in", "in")          PHI_S             PHI;
@segment("PHO") @volatile("PHO", "in", "inout")       uint<7>           PHO[5];
uint<8>                                                                 NGSFBuffer[64];
uint<10>                                                                GLSP;
uint<10>                                                                GLTP;
uint<6>                                                                 LLTP;
uint<8>                                                                 Vrf;
uint<6>                                                                 FQID;
uint<14>                                                                PktLength;
uint<1>                                                                 DropFlag;
uint<1>                                                                 IsUc;
uint<12>                                                                Mgid;
uint<8>                                                                 SB;
uint<8>                                                                 SP;
uint<8>                                                                 TB;
uint<8>                                                                 TP;
// register
uint<16>                                                                HashValue;
uint<8>                                                                 TOS;
uint<8>                                                                 TTL;
uint<8>                                                                 EncapIndex;
uint<3>                                                                 HubSpkGrp;
uint<2>                                                                 EncapProfile;

/****************************        Parser           *********************************/
@parser void iprs( )
{
    return parse_ETHER();
};

@parser void eprs( )
{
    return parse_ETHER();
};

@parser(PG_OUTER_L2) 
void  parse_ETHER()
{
  PHI.L2Type = L2_TYPE_ETHERNET;
  PHO[PHO_OUTER_L2_START] = _extract(ETHER);

  return switch(ETHER.ETHER_TYPE.Type)
  {
     case 0x8100: parse_VlanTag();
     case 0x0800: parse_IPv4();
     case 0x86dd: parse_IPv6();
     default: _parser_next(0, 0);
  }
}
@parser(PG_OUTER_L2)
void parse_VlanTag()
{
  PHI.TagType = VLAN_SINGLE_TAGGED;
  PHO[PHO_OUTER_VLANS_START] = _extract(VLAN_TAG0);

  return switch (VLAN_TAG0.ETHER_TYPE.Type)
  {
     case 0x0800: parse_IPv4();
     case 0x86dd: parse_IPv6();
     default : _parser_next(0, 0);
  }
}
@parser(PG_OUTER_L3)
void  parse_IPv4()
{
  PHI.L3Type = L3_TYPE_IPv4;
  PHO[PHO_OUTER_L3_START] = _extract(IPv4);

  return switch(IPv4.Protocol)
  {
	  case IP_PROTOCOL_UDP:  parse_UDP();
	  case IP_PROTOCOL_TCP:  parse_TCP();
    default : _parser_next(0, 0);
  }
}
@parser(PG_OUTER_L3)
void  parse_IPv6()
{
  PHI.L3Type = L3_TYPE_IPv6;
  PHO[PHO_OUTER_L3_START] = _extract(IPv6);

  return switch(IPv6.NextProtocol)
  {
	  case IP_PROTOCOL_UDP:  parse_UDP();
	  case IP_PROTOCOL_TCP:  parse_TCP();
    default : _parser_next(0, 0);
  }
}
@parser(PG_OUTER_L4)
void  parse_TCP()
{  
  PHI.L4Type = L4_PROTOCOL_TCP;

  PHO[PHO_OUTER_L4_START] = _extract(TCP);

  return _parser_next(0, 0);
}
@parser(PG_OUTER_L4)
void  parse_UDP()
{  
  PHI.L4Type = L4_PROTOCOL_UDP;

  PHO[PHO_OUTER_L4_START] = _extract(UDP);

  return _parser_next(0, 0);
}

/****************************        IMA0           *********************************/
struct IpatCtrlInfo_S
{
    uint<1> ForwardEn;
};

struct IPATRSP_S {
    @global_valid uint<1> Valid;
    uint<1> RouterIntf;
    uint<1> QinQ;
    uint<8> VrfId;
    VlanInfo_S Pvid;
};
typedef _inflate<IPATRSP_S> IPATFull_S;

@lookup IPATFull_S IpatLookup(uint<2> &Status)
{
    uint<10> Glsp;
    _compressed_IPATRSP_S CompressedIpatRsp = {0};
    _compressed_IPATRSP_S Mem = {0};

    Glsp = _key();

    Mem = _lookup(SE_TID_IPAT, TBL_LKUP_TYPE_INDEX, Glsp);
    Status = _status(SE_TID_IPAT);
    _memcpy(CompressedIpatRsp, {Mem});
    
    return CompressedIpatRsp;
}

table IPAT_TBL()
{
    key =
    {
      switch (PHI.PortType)
      {
        case PORT_TYPE_ETH:
        {
          GLSP;
          control_parameters =
          {
            control_info = (IpatCtrlInfo_S){1};
          }
        }
        case PORT_TYPE_CPU: {}
        case PORT_TYPE_STACK: {}
        default:
        {
        }
      }
    }

    uint<2> IpatStatus = _status();
    IPATFull_S rsIpat = IpatLookup(IpatStatus);
    IpatCtrlInfo_S   IpatCtrlInfo= _control_info();
}

table IMA0_MATCH_TBL()
{
    IPAT_TBL tbIPAT = IPAT_TBL();

    _apply(tbIPAT);

    ma_id = 0;
}

void iMA0Action(IPATFull_S rsIpat, uint<2> IpatStatus, IpatCtrlInfo_S CtrlInfo)
{
    if (_valid(rsIpat) && CtrlInfo.ForwardEn && PHI.L3Type[1:1] == 1 ) {
        Vrf = rsIpat.VrfId;
        IsUc = 1;
    } else {
        DropFlag = 1;
    }
}

table IMA0_ACTION_TBL(IMA0_MATCH_TBL tbIMA0Match)
{
    iMA0Action(tbIMA0Match.tbIPAT.rsIpat, tbIMA0Match.tbIPAT.IpatStatus, tbIMA0Match.tbIPAT.IpatCtrlInfo);

    ma_id = 0;
}

/****************************        IMA1           *********************************/
struct FIBRSP_S {
    uint<10>  Port;
    uint<8>   EncapIndex;
};

typedef _inflate<FIBRSP_S> FIBFull_S;

struct FIBKEY_S {
    uint<8> VrfId;
    uint<128> DIP;
};

@lookup FIBFull_S FibLookup(uint<2> &Status, uint<4> tid)
{
    FIBKEY_S FibKey;
    _compressed_FIBRSP_S CompressedFibRsp = {0};
    _compressed_FIBRSP_S Mem = {0};

    FibKey = _key();

    Mem = _lookup(SE_TID_FIB, TBL_LKUP_TYPE_LPM, FibKey);
    Status = _status(SE_TID_FIB);
    _memcpy(CompressedFibRsp, {Mem});
    
    return CompressedFibRsp;
}

table FIB_TBL()
{
    key = {
      switch (PHI.L3Type) {
          case L3_TYPE_IPv4: { // ICIB:Heartbeat
              Vrf;
              IPv4.DIP;
              (uint<32>) 0;
              (uint<32>) 0;
              (uint<32>) 0;
              control_parameters = {
                  table_id = 0;
              }
          }
          case L3_TYPE_IPv6: { // ICIB:Heartbeat
              Vrf;
              IPv6.DIP;
              control_parameters = {
                  table_id = 1;
              }
          }
          case L3_TYPE_NON_IP: {}
          case L3_TYPE_INVALID: {}
          default: { 
            //Skip
          }
      }
    }

    uint<2> StatusFib = _status();
    uint<4> tid = _table_id();
    FIBFull_S rsFib = FibLookup(StatusFib, tid);
};

table IMA1_MATCH_TBL()
{
    FIB_TBL               tbFib           = FIB_TBL();
    _apply(tbFib);

    ma_id = 1;
};

void iMA1Action(FIBFull_S rsFib)
{
    if (_valid(rsFib)) {
        GLTP = rsFib.Port;
        EncapIndex = rsFib.EncapIndex;
        TTL = TTL - 1;
    }
}

table IMA1_ACTION_TBL(IMA1_MATCH_TBL tbIMA1Match)
{  
    iMA1Action(tbIMA1Match.tbFib.rsFib);

    ma_id = 1;
};

/****************************        IPPMAIN           *********************************/
table IPRS_TBL()
{  
  iprs();
};

@control void pre_iMAControl()
{
  @hw_map("IPRS") IPRS_TBL tbIprs          = IPRS_TBL();
  _apply(tbIprs);
}

@control void iMA0Control()
{
  @hw_map("IMA0_MATCH")       IMA0_MATCH_TBL         tbIMA0Match       = IMA0_MATCH_TBL();
  @hw_map("IMA0_ACTION")      IMA0_ACTION_TBL        tbIMA0Action      = IMA0_ACTION_TBL(tbIMA0Match);

  _apply(tbIMA0Match);
  _apply(tbIMA0Action);
}

@control void iMA1Control()
{
  @hw_map("IMA1_MATCH")       IMA1_MATCH_TBL         tbIMA1Match       = IMA1_MATCH_TBL();
  @hw_map("IMA1_ACTION")      IMA1_ACTION_TBL        tbIMA1Action      = IMA1_ACTION_TBL(tbIMA1Match);

  _apply(tbIMA1Match);
  _apply(tbIMA1Action);
}

@control void ingress()
{
  pre_iMAControl();
 
  iMA0Control();

  iMA1Control();

}

/****************************        EMA0           *********************************/
struct ENCAP_LOCAL_ADDR_S {
    uint<48> SMAC;
};
struct EPATRSP_S {
    @global_valid uint<1> Valid;
    uint<31> Rsvd;
    @dma union {
        ENCAP_LOCAL_ADDR_S Addr;
    }Dma;
};
typedef _inflate<EPATRSP_S> EPATFull_S;

struct ENCAP_ARP_S {
    uint<48> DMAC;
};

struct ENCAPRSP_S {
    @global_valid uint<1> Valid;
    uint<31> Rsvd;

    @dma union {
        ENCAP_ARP_S Arp;
    }Dma;
};
typedef _inflate<ENCAPRSP_S> ENCAPFull_S;

@lookup EPATFull_S EpatLookup(uint<2> &Status)
{
    uint<10> Gltp;
    _compressed_EPATRSP_S CompressedEpatRsp = {0};
    _compressed_EPATRSP_S Mem = {0};

    Gltp = _key();

    Mem = _lookup(SE_TID_EPAT, TBL_LKUP_TYPE_INDEX, Gltp);
    Status = _status(SE_TID_EPAT);
    _memcpy(CompressedEpatRsp, {Mem});
    
    return CompressedEpatRsp;
}

@lookup ENCAPFull_S EncapLookup(uint<2> &Status)
{
    uint<8> index;
    _compressed_ENCAPRSP_S CompressedEncapRsp = {0};
    _compressed_ENCAPRSP_S Mem = {0};

    index = _key();

    Mem = _lookup(SE_TID_ENCAP, TBL_LKUP_TYPE_INDEX, index);
    Status = _status(SE_TID_ENCAP);
    _memcpy(CompressedEncapRsp, {Mem});
    
    return CompressedEncapRsp;
}

table EPAT_TBL()
{
    key =
    {
        switch (PHI.PortType)
        {
             //PHI.Part1.PortType
             case PORT_TYPE_ETH:
             {
                 GLTP;
             }

             default:
             {
             }
        }
    }

    uint<2> EpatStatus = _status();
    EPATFull_S rsEpat = EpatLookup(EpatStatus);
}
table ENCAP_TBL()
{
    key =
    {
        switch (PHI.PortType)
        {
             //PHI.Part1.PortType
             case PORT_TYPE_ETH:
             {
                 EncapIndex;
             }

             default:
             {
             }
        }
    }

    // IPATFull_S rsIpat = _lookup();
    uint<2> EncapStatus = _status();
    ENCAPFull_S rsEncap = EncapLookup(EncapStatus);
}

table EMA0_MATCH_TBL()
{
    EPAT_TBL tbEPAT         = EPAT_TBL();
    ENCAP_TBL tbEncap       = ENCAP_TBL();

    _apply(tbEPAT);
    _apply(tbEncap);
    ma_id = 0;
}

void eMA0Action(EPATFull_S rsEpat, ENCAPFull_S rsEncap)
{
    if (IsUc) {
        EncapProfile = 1;
    } else {
        EncapProfile = 0;
    }
}

table EMA0_ACTION_TBL(EMA0_MATCH_TBL tbEMA0Match)
{
    eMA0Action(tbEMA0Match.tbEPAT.rsEpat, tbEMA0Match.tbEncap.rsEncap);
    
    ma_id = 0;
}

@dma_primitive void EthODma(EPATFull_S rsEpat, ENCAPFull_S rsEncap)
{
    switch (EncapProfile) {
        case 1: {
            ETHER.Dmac = rsEncap.Dma.Arp.DMAC;
            ETHER.Smac = rsEpat.Dma.Addr.SMAC;
        }
        default: {
        }
    }
}
@fwd_primitive void IpOverwrite()
{
    switch (EncapProfile)
    {
        case 1: {
            IPv4.TTL = TTL;
            IPv4.u_0.TOS = TOS;
        } 
        default: {
        }
    }
}

void eMA0_HmProc(EPATFull_S rsEpat, ENCAPFull_S rsEncap)
{
    EthODma(rsEpat, rsEncap);

    IpOverwrite();
}

table EMA0_HM_TBL(EMA0_MATCH_TBL tbEMA0Match)
{
    eMA0_HmProc(tbEMA0Match.tbEPAT.rsEpat, tbEMA0Match.tbEncap.rsEncap);

    ma_id = 0;
}

/****************************        EPPMAIN           *********************************/
table EPRS_TBL()
{
  eprs();
};

@control void pre_eMAControl()
{
  @hw_map("EPRS")       EPRS_TBL tbEprs		= EPRS_TBL();  

  _apply(tbEprs); 
}

@control void eMA0Control()
{
  @hw_map("EMA0_MATCH")       EMA0_MATCH_TBL         tbEMA0Match       = EMA0_MATCH_TBL();
  @hw_map("EMA0_ACTION")      EMA0_ACTION_TBL        tbEMA0Action      = EMA0_ACTION_TBL(tbEMA0Match);
  @hw_map("EMA1_HM") @modifier EMA0_HM_TBL           tbEMA0HM          = EMA0_HM_TBL(tbEMA0Match);

  _apply(tbEMA0Match);
  _apply(tbEMA0Action);
  _apply(tbEMA0HM);
}

@control void egress()
{
  pre_eMAControl();
  
  eMA0Control();
}


void func0()
{
  uint<8> A = 1;
  uint<8> B = 2;
  uint<8> C = 3;
  uint<4> a = 0;
  uint<4> b = 0;

  return switch (A, B, C){
    case 1, 2, 3: parse_IPv4();
    case 1, 0&&&0, 4: {}
    case 1, 1&&&0, 5:
    case a&&&b, 2, 1: parse_IPv6();
    default : _parser_next(0, 0);
  }
}

void func1()
{
  uint<8> A = 1;
  uint<8> B = 2;
  uint<8> C = 3;
  uint<8> Z;

  switch (A, B, C){
    case 1, 0&&&0, 4: {
      Z = 1;
    }
    case 0&&&0, 2, 1: {}
    case 1, 2, 3: {}
    case 1, 3, 3:
    case 1, 4, 3: {
      Z = 2;
    }
    default:
    {
      Z = 0;
    }
  }
}

table TBL()
{
  uint<8> A = 1;
  uint<8> B = 2;
  uint<8> C = 3;
  uint<8> Z;

  switch (A, B, C){
    case 1, 0&&&0, 4: {
      Z = 1;
    }
    case 0&&&0, 2, 1: {}
    case 1, 2, 3: {}
    case 1, 3, 3:
    case 1, 4, 3: {
      Z = 2;
    }
    default: {
      Z = 0;
    }
  }
}

table TBL_key()
{
  uint<8> A = 1;
  uint<8> B = 2;
  uint<8> C = 3;
  uint<8> Z = 4;
  uint<8> Y = 5;

  key =
  {
    switch (A, B, C){
      case 1, 0&&&0, 4: {
        Z;
        control_parameters =
        {
          command = 0;
        }
      }
      case 0&&&0, 2, 1: {
        Z;
        control_parameters =
        {
          command = 1;
        }
      }
      case 1, 2, 3: {}
      case 1, 3, 3:
      case 1, 4, 3: {
        Z;
        control_parameters =
        {
          command = 3;
        }
      }
      default: {
      }
    }

    switch (A, B, C){
      case 1, 0&&&0, 4: {
        Y;
        control_parameters =
        {
          command = 0;
        }
      }
      case 0&&&0, 2, 1: {
        Y;
        control_parameters =
        {
          command = 1;
        }
      }
      case 1, 2, 3: {
        Y;
        control_parameters =
        {
          command = 2;
        }
      }
      case 1, 3, 3: {}
      case 1, 4, 3: {
        Y;
        control_parameters =
        {
          command = 3;
        }
      }
      default: {
      }
    }
  }
}

void dot_ex(){

  UDP_S test = { .SrcPort = 1 };

}