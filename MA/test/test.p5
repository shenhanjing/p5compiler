#define PG_OUTER_L2  0
#define PG_OUTER_L3  1
#define PG_OUTER_L4  2

#define IP_PROTOCOL_TCP      0x06
#define IP_PROTOCOL_UDP      0x11

enum RSP_STATUS_E
{
  RSP_STATUS_MATCH          = 0,
  RSP_STATUS_NO_MATCH       = 1,
  RSP_STATUS_LOOKUP_SKIPPED = 2,
  RSP_STATUS_ERROR          = 3
};

enum TLB_LKUP_TYPE_E
{
  TBL_LKUP_TYPE_INDEX                    = 0,
  TBL_LKUP_TYPE_EM                       = 1,
  TBL_LKUP_TYPE_LPM                      = 3,
  TBL_LKUP_TYPE_TCAM                     = 4
};

enum SE_TID_E
{
    SE_TID_IPAT                    =    0,
    SE_TID_FIB                     =    1,
    SE_TID_EPAT                    =    2,
    SE_TID_ENCAP                   =    3
};

enum PORT_TYPE_E
{
    PORT_TYPE_ETH          = 0,
    PORT_TYPE_CPU          = 1,
    PORT_TYPE_STACK        = 2
};

enum PHO_OFFSETS_E 
{
  PHO_OUTER_L2_START                    = 0,
  PHO_OUTER_VLANS_START                 = 1,
  PHO_OUTER_L3_START                    = 2,
  PHO_OUTER_L4_START                    = 3

};

enum L4_PROTOCOL_E
{
  L4_PROTOCOL_NONE             = 0,

  L4_PROTOCOL_TCP              = 10,
  
  L4_PROTOCOL_UDP	             = 32
};

enum L2_TYPE_E
{
  L2_TYPE_INVALID  = 0,
  L2_TYPE_ETHERNET = 1,
  L2_TYPE_OTHER    = 2,
  L2_TYPE_RES      = 3
};

enum VLAN_TYPE_E
{
  VLAN_UNTAGGED = 0,
  VLAN_SINGLE_TAGGED = 1,
  VLAN_DOUBLE_TAGGED = 2,
  VLAN_TRIPLE_TAGGED = 3
};
enum L3_TYPE_E
{
  L3_TYPE_INVALID = 0,
  L3_TYPE_NON_IP = 1,
  L3_TYPE_IPv4 = 2,
  L3_TYPE_IPv6 = 3
};

struct PHI_S //18 | 3 | 5
{
  uint<4> PortType;
  uint<2> L2Type;
  uint<2> TagType;
  uint<2> L3Type;
  uint<8> L4Type;
};

struct ETHER_TYPE_S //16 | 2 | 2
{
  uint<16>    Type;
};

struct ETHER_S //96 | 12 | 12
{
  uint<48> Dmac;
  uint<48> Smac;
  ETHER_TYPE_S ETHER_TYPE;
};

struct VlanInfo_S { //16 | 2 | 3
    uint<3> Pri;
    uint<1> Dei;
    uint<12> VlanID;
};

struct VLAN_TAG_S //32 | 4 | 5
{
  uint<16>     Tpid;
  VlanInfo_S   VlanInfo;
  ETHER_TYPE_S ETHER_TYPE;
};

struct IPv4_S //160 | 20 | 24
{
  uint<4>    Version;
  uint<4>    Ihl;
  uint<8>    TOS;
  uint<16>    TotalLen;
  uint<16>    Iden;
  uint<1>     R;
  uint<1>     DF;
  uint<1>     MF;
  uint<13>    FragOffset;
  uint<8>       TTL;
  uint<8>       Protocol;
  uint<16>      Checksum;
  uint<32>      SIP;
  uint<32>      DIP;
};
struct IPv6_S //320 | 40 | 41
{
  uint<4>   Version;
  uint<8>   TC;              /*Traffic Class*/
  uint<20>  FlowLabel;            /*Flow Label*/
  uint<16>  PayloadLen;           /*Length of packet after IPv6 header*/
  uint<8>   NextProtocol;         /*Type of next header after this one*/
  uint<8>   HopLmt;               /*Hop limit*/
  uint<128>  SIP;                 /*Source address */
  uint<128>  DIP;                 /*Destination address  */
};

struct UDP_S //64 | 8 | 8
{
  uint<16>    SrcPort;
  uint<16>    DstPort;
  uint<16>    Length;
  uint<16>    Checksum;
};

struct FlagCtrl_S //6 | 1 | 6
{
  uint<1>    Urg;
  uint<1>    Ack;
  uint<1>    Psh;
  uint<1>    Rst;
  uint<1>    Syn;
  uint<1>    Fin;
};

struct DataCtrl_S //16 | 2 | 8
{
  uint<4>    DataOffset;
  uint<3>    Res;
  uint<3>    Ecn;
  FlagCtrl_S Ctrl;
};

struct TCP_S //160 | 20 | 26
{
  uint<16>    SrcPort;
  uint<16>    DstPort;
  uint<32>    SeqNo;
  uint<32>    AckNo;
  DataCtrl_S  DataCtrl;
  uint<16>    Window;
  uint<16>    Checksum;
  uint<16>    UrgentPtr;
};

/****************************        Outer Headers           *********************************/
ETHER_S ETHER;
VLAN_TAG_S VLAN_TAG0;
ETHER_TYPE_S ETHER_TYPE;

IPv4_S IPv4;
IPv6_S IPv6;

UDP_S UDP;
TCP_S TCP;

/****************************        FV           *********************************/
@segment("PHI") @volatile("PHI", "in", "in")          PHI_S             PHI;
@segment("PHO") @volatile("PHO", "in", "inout")       uint<7>           PHO[5];
uint<8>                                                                 NGSFBuffer[64];
uint<10>                                                                GLSP;
uint<10>                                                                GLTP;
uint<6>                                                                 LLTP;
uint<8>                                                                 Vrf;
uint<6>                                                                 FQID;
uint<14>                                                                PktLength;
uint<1>                                                                 DropFlag;
uint<1>                                                                 IsUc;
uint<12>                                                                Mgid;
uint<8>                                                                 SB;
uint<8>                                                                 SP;
uint<8>                                                                 TB;
uint<8>                                                                 TP;
// register
uint<16>                                                                HashValue;
uint<8>                                                                 TOS;
uint<8>                                                                 TTL;
uint<8>                                                                 EncapIndex;
uint<3>                                                                 HubSpkGrp;
uint<2>                                                                 EncapProfile;

/****************************        Parser           *********************************/
@parser void iprs( )
{
    return parse_ETHER();
};

@parser void eprs( )
{
    return parse_ETHER();
};

@parser(PG_OUTER_L2) 
void  parse_ETHER()
{
  PHI.L2Type = L2_TYPE_ETHERNET;
  PHO[PHO_OUTER_L2_START] = _extract(ETHER);

  return switch(ETHER.ETHER_TYPE.Type)
  {
     case 0x8100: parse_VlanTag();
     case 0x0800: parse_IPv4();
     case 0x86dd: parse_IPv6();
     default: _parser_next(0, 0);
  }
}
@parser(PG_OUTER_L2)
void parse_VlanTag()
{
  PHI.TagType = VLAN_SINGLE_TAGGED;
  PHO[PHO_OUTER_VLANS_START] = _extract(VLAN_TAG0);

  return switch (VLAN_TAG0.ETHER_TYPE.Type)
  {
     case 0x0800: parse_IPv4();
     case 0x86dd: parse_IPv6();
     default : _parser_next(0, 0);
  }
}
@parser(PG_OUTER_L3)
void  parse_IPv4()
{
  PHI.L3Type = L3_TYPE_IPv4;
  PHO[PHO_OUTER_L3_START] = _extract(IPv4);

  return switch(IPv4.Protocol)
  {
	  case IP_PROTOCOL_UDP:  parse_UDP();
	  case IP_PROTOCOL_TCP:  parse_TCP();
    default : _parser_next(0, 0);
  }
}
@parser(PG_OUTER_L3)
void  parse_IPv6()
{
  PHI.L3Type = L3_TYPE_IPv6;
  PHO[PHO_OUTER_L3_START] = _extract(IPv6);

  return switch(IPv6.NextProtocol)
  {
	  case IP_PROTOCOL_UDP:  parse_UDP();
	  case IP_PROTOCOL_TCP:  parse_TCP();
    default : _parser_next(0, 0);
  }
}
@parser(PG_OUTER_L4)
void  parse_TCP()
{  
  PHI.L4Type = L4_PROTOCOL_TCP;

  PHO[PHO_OUTER_L4_START] = _extract(TCP);

  return _parser_next(0, 0);
}
@parser(PG_OUTER_L4)
void  parse_UDP()
{  
  PHI.L4Type = L4_PROTOCOL_UDP;

  PHO[PHO_OUTER_L4_START] = _extract(UDP);

  return _parser_next(0, 0);
}

/****************************        IMA0           *********************************/
struct IPATRSP_S {
    @global_valid uint<1> Valid;
    uint<1> RouterIntf;
    uint<1> QinQ;
    uint<8> VrfId;
    VlanInfo_S Pvid;
};
typedef _inflate<IPATRSP_S> IPATFull_S;

@lookup IPATFull_S IpatLookup(uint<2> &Status)
{
    uint<10> Glsp;
    _compressed_IPATRSP_S CompressedIpatRsp = {0};
    _compressed_IPATRSP_S Mem = {0};

    Glsp = _key();

    Mem = _lookup(SE_TID_IPAT, TBL_LKUP_TYPE_INDEX, Glsp);
    Status = _status(SE_TID_IPAT);
    _memcpy(CompressedIpatRsp, {Mem});
    
    return CompressedIpatRsp;
}

table IPAT_TBL()
{
    key =
    {
        GLSP;
    }

    uint<2> IpatStatus = _status();
    IPATFull_S rsIpat = IpatLookup(IpatStatus);
}

table IMA0_MATCH_TBL()
{
    IPAT_TBL tbIPAT = IPAT_TBL();

    _apply(tbIPAT);
}

void iMA0Action(IPATFull_S rsIpat, uint<2> IpatStatus)
{
    if (_valid(rsIpat) && ((PHI.L3Type == L3_TYPE_IPv4) || (PHI.L3Type == L3_TYPE_IPv6)) ) {
        Vrf = rsIpat.VrfId;
        IsUc = 1;
    } else {
        DropFlag = 1;
    }
}

table IMA0_ACTION_TBL(IMA0_MATCH_TBL tbIMA0Match)
{
    iMA0Action(tbIMA0Match.tbIPAT.rsIpat, tbIMA0Match.tbIPAT.IpatStatus);
}

/****************************        IMA1           *********************************/
struct FIBRSP_S {
    uint<10>  Port;
    uint<8>   EncapIndex;
};

typedef _inflate<FIBRSP_S> FIBFull_S;

@lookup FIBFull_S FibLookup(uint<2> &Status)
{
    uint<136> FibKey;
    _compressed_FIBRSP_S CompressedFibRsp = {0};
    _compressed_FIBRSP_S Mem = {0};

    FibKey = _key();

    Mem = _lookup(SE_TID_FIB, TBL_LKUP_TYPE_LPM, FibKey);
    Status = _status(SE_TID_FIB);
    _memcpy(CompressedFibRsp, {Mem});
    
    return CompressedFibRsp;
}

table FIB_TBL()
{
    key = {
      switch (PHI.L3Type) {
          case L3_TYPE_IPv4: { // ICIB:Heartbeat
              Vrf;
              IPv4.DIP;
              (uint<32>) 0;
              (uint<32>) 0;
              (uint<32>) 0;
          }
          case L3_TYPE_IPv6: { // ICIB:Heartbeat
              Vrf;
              IPv6.DIP;
          }
          default: { 
            //Skip
          }
      }
    }

    uint<2> StatusFib = _status();
    FIBFull_S rsFib = FibLookup(StatusFib);
};

table IMA1_MATCH_TBL()
{
    FIB_TBL               tbFib           = FIB_TBL();
    _apply(tbFib);
};

void iMA1Action(FIBFull_S rsFib)
{
    if (_valid(rsFib)) {
        GLTP = rsFib.Port;
        EncapIndex = rsFib.EncapIndex;
        TTL = TTL - 1;
    }
}

table IMA1_ACTION_TBL(IMA1_MATCH_TBL tbIMA1Match)
{  
    iMA1Action(tbIMA1Match.tbFib.rsFib);
};

/****************************        IPPMAIN           *********************************/
table IPRS_TBL()
{  
  iprs();
};

@control void pre_iMAControl()
{
  @hw_map("IPRS") IPRS_TBL tbIprs          = IPRS_TBL();
  _apply(tbIprs);
}

@control void iMA0Control()
{
  @hw_map("IMA0_MATCH")       IMA0_MATCH_TBL         tbIMA0Match       = IMA0_MATCH_TBL();
  @hw_map("IMA0_ACTION")      IMA0_ACTION_TBL        tbIMA0Action      = IMA0_ACTION_TBL(tbIMA0Match);

  _apply(tbIMA0Match);
  _apply(tbIMA0Action);
}

@control void iMA1Control()
{
  @hw_map("IMA1_MATCH")       IMA1_MATCH_TBL         tbIMA1Match       = IMA1_MATCH_TBL();
  @hw_map("IMA1_ACTION")      IMA1_ACTION_TBL        tbIMA1Action      = IMA1_ACTION_TBL(tbIMA1Match);

  _apply(tbIMA1Match);
  _apply(tbIMA1Action);
}

@control void ingress()
{
  pre_iMAControl();
 
  iMA0Control();

  iMA1Control();

}
