class P5Table : Declaration, IAnnotated, ISimpleNamespace {
    optional inline Vector<Annotation> annotations;
    ParameterList parameters;
    BlockStatement body;

    const Vector<Annotation> &getAnnotations() const override { return annotations; }
    Vector<Annotation> &getAnnotations() override { return annotations; }

    Util::Enumerator<IDeclaration> *getDeclarations() const override {
        return parameters->getDeclarations(); }
    IDeclaration getDeclByName(cstring name) const override {
        return parameters->getDeclByName(name); }
    IDeclaration getDeclByName(std::string_view name) const override {
        return parameters->getDeclByName(name); }

    dbprint { out << "P5Table " << name; }
}

class P5KeyElement : IAnnotated {
    optional inline Vector<Annotation> annotations;
    optional NullOK Expression expr;
    optional NullOK ID matchType;
    optional NullOK inline BlockStatement control;
    dbprint { out << "P5KeyElement"; }

    const Vector<Annotation> &getAnnotations() const override { return annotations; }
    Vector<Annotation> &getAnnotations() override { return annotations; }
}

class P5KeyCase : IAnnotated {
    optional inline Vector<Annotation> annotations;
    optional NullOK Expression label;
    optional inline Vector<P5KeyElement> elements;
    // When true, this case has no body and should fall through to next case.
    // This is used to represent "case ...:" with nothing after ':' (C-style stacked labels).
    optional inline bool fallthrough;
    dbprint { out << "P5KeyCase"; }

    const Vector<Annotation> &getAnnotations() const override { return annotations; }
    Vector<Annotation> &getAnnotations() override { return annotations; }
}

class P5KeySwitch : IAnnotated {
    optional inline Vector<Annotation> annotations;
    NullOK Expression select;
    optional inline Vector<P5KeyCase> cases;
    dbprint { out << "P5KeySwitch"; }

    const Vector<Annotation> &getAnnotations() const override { return annotations; }
    Vector<Annotation> &getAnnotations() override { return annotations; }
}

class P5Key : Statement {
    optional inline Vector<P5KeyElement> elements; // flat list (optional)
    // Switch-style key blocks in source order; allows multiple switches in a single key={...}.
    optional inline Vector<P5KeySwitch> switches;
    dbprint { out << "P5Key"; }
}

// Expression forms needed by the P5 frontend (primarily for C-style initializer lists).
class P5DesignatedInitializer : Expression {
    // When true, emit ".<designator> = <value>".
    // When false, emit "[<designator>] = <value>".
    bool isMember;
    Expression designator;
    Expression value;
    dbprint { out << "P5DesignatedInitializer"; }
}

// Post-increment as an expression: "expr++".
// Codegen is responsible for preserving the value/side-effect semantics.
class P5PostIncrement : Expression {
    Expression expr;
    dbprint { out << "P5PostIncrement"; }
}
