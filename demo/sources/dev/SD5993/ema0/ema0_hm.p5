@dma_primitive void EthODma(EPATFull_S rsEpat, ENCAPFull_S rsEncap)
{
    switch (EncapProfile) {
        case 1: {
            ETHER.Dmac = rsEncap.Dma.Arp.DMAC;
            ETHER.Smac = rsEpat.Dma.Addr.SMAC;
        }
        default: {
        }
    }
}
@fwd_primitive void IpOverwrite()
{
    switch (EncapProfile)
    {
        case 1: {
            IPv4.TTL = TTL;
            IPv4.u_0.TOS = TOS;
        } 
        default: {
        }
    }
}

void eMA0_HmProc(EPATFull_S rsEpat, ENCAPFull_S rsEncap)
{
    EthODma(rsEpat, rsEncap);

    IpOverwrite();
}