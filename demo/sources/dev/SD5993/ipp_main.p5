@table class IPRS_TBL()
{  
  iprs();
};

@control void pre_iMAControl()
{
  @hw_map("IPRS") IPRS_TBL tbIprs          = IPRS_TBL();
  _apply(tbIprs);
}

@control void iMA0Control()
{
  @hw_map("IMA0_MATCH")       IMA0_MATCH_TBL         tbIMA0Match       = IMA0_MATCH_TBL();
  @hw_map("IMA0_ACTION")      IMA0_ACTION_TBL        tbIMA0Action      = IMA0_ACTION_TBL(tbIMA0Match);

  _apply(tbIMA0Match);
  _apply(tbIMA0Action);
}

@control void iMA1Control()
{
    @hw_map("IMA1_MATCH")       IMA1_MATCH_TBL         tbIMA1Match       = IMA1_MATCH_TBL();
    @hw_map("IMA1_ACTION")      IMA1_ACTION_TBL        tbIMA1Action      = IMA1_ACTION_TBL(tbIMA1Match);

    _apply(tbIMA1Match);
    _apply(tbIMA1Action);
}


@control void IpmControl()
{
  @hw_map("IPM_NP_CONVERTER") IFV2NGSF_TBL tbIFv2Ngsf = IFV2NGSF_TBL();

  _apply(tbIFv2Ngsf);
}

@control void ingress()
{
  pre_iMAControl();
 
  iMA0Control();

  iMA1Control();

  IpmControl();

}


