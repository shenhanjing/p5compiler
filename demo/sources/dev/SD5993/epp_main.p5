@table class EPRS_TBL()
{
  eprs();
};

@control void pre_eMAControl()
{
  @hw_map("EPRS_NP_CONVERTER") ENGSF2FV_TBL tbENgsf2Fv = ENGSF2FV_TBL();
  @hw_map("EPRS")       EPRS_TBL tbEprs		= EPRS_TBL();  

  _apply(tbENgsf2Fv);
  _apply(tbEprs); 
}

@control void eMA0Control()
{
  @hw_map("EMA0_MATCH")       EMA0_MATCH_TBL         tbEMA0Match       = EMA0_MATCH_TBL();
  @hw_map("EMA0_ACTION")      EMA0_ACTION_TBL        tbEMA0Action      = EMA0_ACTION_TBL(tbEMA0Match);
  @hw_map("EMA1_HM") @modifier EMA0_HM_TBL           tbEMA0HM          = EMA0_HM_TBL(tbEMA0Match);

  _apply(tbEMA0Match);
  _apply(tbEMA0Action);
  _apply(tbEMA0HM);
}
/*
@control void eMA1Control()
{
  @hw_map("EMA1_MATCH")        EMA1_MATCH_TBL        tbEMA1Match       = EMA1_MATCH_TBL();
  @hw_map("EMA1_ACTION")       EMA1_ACTION_TBL       tbEMA1Action      = EMA1_ACTION_TBL(tbEMA1Match);

  _apply(tbEMA1Match);
  _apply(tbEMA1Action);
}*/

@control void egress()
{
  pre_eMAControl();

  eMA0Control();

  //eMA1Control();
}
