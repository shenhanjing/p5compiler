#define _port_mapping _mapping_converter
#define FV2NGSF "NP"
#define NGSF2FV "NGSF"
#define FV_NGSF_BDR "NP"

void genNGSFTm2Np(uint<8> tmpTP)
{
    _add_to_ngsf((uint<6>)0); //Reserved
    _add_to_ngsf(FQID);
    _add_to_ngsf((uint<1>) 0); //Reserved
    _add_to_ngsf((uint<14>) PktLength);
    _add_to_ngsf(tmpTP);
}

void genNGSFNp2Tm(uint<8> tmpTB, uint<8> tmpTP)
{
    _add_to_ngsf(DropFlag);
    if (IsUc == 1) {
      _add_to_ngsf(tmpTB);
      _add_to_ngsf(tmpTP);
    } else {
        _add_to_ngsf(Mgid);
    }
}

void genNGSFBasic(uint<8> tmpSB, uint<8> tmpSP, uint<8> tmpTP)
{
    _add_to_ngsf(IsUc);
    _add_to_ngsf(tmpSB);
    _add_to_ngsf(tmpSP);
    if (IsUc == 1) {
        _add_to_ngsf(tmpTP);
    } else {
        _add_to_ngsf(HashValue[7:0]);
    }
}

void genNGSFExt1()
{
    if(IsUc == 1) {
        genNGSFExt1L3();
    } else {
        genNGSFExt1Mc();
    }
}

void genNGSFExt1L3()
{
    _add_to_ngsf(Vrf);
    _add_to_ngsf(TTL);
    _add_to_ngsf(EncapIndex);
    _add_to_ngsf(TOS);
}

void genNGSFExt1Mc()
{
    _add_to_ngsf(Mgid);
    _add_to_ngsf(HubSpkGrp);
    _add_to_ngsf(HashValue[9:8]);
    _add_to_ngsf(TOS);
}

@accelerator(FV2NGSF)
void iFv2Ngsf(uint<8>buffer[])
{
    uint<8> tmpSb;
    uint<8> tmpSP;
    uint<8> tmpTB;
    uint<8> tmpTP;

    _port_mapping("GLSP", tmpSb, tmpSP, GLSP);
    _port_mapping("GLTP", tmpTB, tmpTP, GLTP);
    genNGSFNp2Tm(tmpTB, tmpTP);
    genNGSFBasic(tmpSb, tmpSP, tmpTP);
    genNGSFExt1();
}

@accelerator(NGSF2FV)
void eNgsf2Fv(uint<8>buffer[])
{
    uint<8> tmpSP;
    uint<8> tmpTP;
    genNGSFTm2Np(tmpTP);
    genNGSFBasic(SB, tmpSP, 0);
    genNGSFExt1();
    _port_mapping("GLSP", SB, tmpSP, GLSP);
    _port_mapping("LLTP", tmpTP, GLTP, LLTP);
}


table IFV2NGSF_TBL()
{
    iFv2Ngsf(NGSFBuffer);
}

table ENGSF2FV_TBL()
{
    eNgsf2Fv(NGSFBuffer);
}

